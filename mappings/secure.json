{
  "mappings": [
    {
      "priority": 1,
      "request": {
        "method": "GET",
        "urlPath": "/api/secure/profile",
        "headers": {
          "Authorization": { "equalTo": "Bearer let-me-in" }
        }
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "user": "jane.doe", "roles": ["admin"] }
      }
    },
    {
      "priority": 10,
      "request": {
        "method": "GET",
        "urlPath": "/api/secure/profile"
      },
      "response": {
        "status": 401,
        "headers": {
          "Content-Type": "application/json",
          "WWW-Authenticate": "Bearer"
        },
        "jsonBody": { "error": "unauthorized" }
      }
    }
  ]
