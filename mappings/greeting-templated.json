{
  "request": {
    "method": "GET",
    "urlPath": "/api/greeting",
    "queryParameters": {
      "name": { "matches": ".+" }
    }
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "message": "Hello, {{request.query.name}}!",
      "requestedAt": "{{now}}"
    },
    "transformers": ["response-template"]
  }
}
